{
	"name": "campus-food-order-backend",
    "main": "index.ts",
	// required for database drivers to function
	"compatibility_flags": [
		"nodejs_compat",
		"enable_nodejs_http_server_modules"
	],
	// Set this to today's date
	"compatibility_date": "2026-11-10",
	"vars": {
		"OSS_BUCKET": "campus-food-order-images",
		"OSS_REGION": "cn-hangzhou",
		"OSS_STS_ROLE_ARN": "acs:ram::1488038816515091:role/oss-upload-role"
	},
	"hyperdrive": [
		{
			"binding": "HYPERDRIVE",
			"id": "db7f6c06fb4f42068962e48dbbcb8260"
		}
	],
	"alias": {
    "aws-sdk": "./empty.js",
    "nock": "./empty.js",
    "mock-aws-s3": "./empty.js"
  }
}
