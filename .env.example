# Server
PORT=4000
NODE_ENV=development

# Database
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=your_password_here
DB_NAME=campus_food_order

# JWT
JWT_SECRET=your_jwt_secret_here_at_least_32_characters_long_for_security
JWT_EXPIRES_IN=7d

# CORS
CORS_ORIGIN=http://localhost:3000,http://localhost:3001

# File Upload
UPLOAD_MODE=local
UPLOAD_DIR=uploads
BASE_URL=http://localhost:4000

# OSS (Aliyun OSS for production, optional)
OSS_REGION=oss-cn-hangzhou
OSS_ACCESS_KEY_ID=
OSS_ACCESS_KEY_SECRET=
OSS_BUCKET=

# AI Service (Optional - for AI-powered dish recommendation)
# If not set, will fallback to rule-based parsing
ANTHROPIC_API_KEY=
